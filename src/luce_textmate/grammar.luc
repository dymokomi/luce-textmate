#==============================================================================================
#
#   grammar - the TextMate grammar model and loader
#
#   DESCRIPTION:
#       Turns a `.tmLanguage.json` document into rules the tokenizer can run: a `match`, a
#       `begin`/`end` (or `begin`/`while`) region, or a grouping/include holder spliced in where
#       it is referenced. Each pattern is compiled to a luce-regex `Regex`; a pattern the engine
#       cannot compile becomes inert rather than failing the whole grammar. Only the standard
#       library, luce-regex and the package's JSON reader are used.
#
#==============================================================================================

from regex import Regex
from luce_textmate.json import Json, parse

## A grammar whose JSON did not describe a usable rule set.
pub let grammar_error: ErrorCode = ErrorCode.package(332)

let R_MATCH = 0
let R_BEGIN = 1
let R_GROUP = 2

# mark: The model =============================================================================

## The scope assigned to one capture group of a rule's regex.
pub class Capture:
    pub let index: int
    pub let scope: str

    func init(self, index: int, scope: str):
        self.index = index
        self.scope = scope

## One rule. A `match` rule colours a single regex; a `begin` rule opens a region closed by its
## `end` (or held open line by line by its `while`); a grouping rule only contributes `patterns`.
pub class Rule:
    var kind: int
    pub var scope: str
    pub var content_scope: str
    pub var matcher: Regex?
    pub var begin: Regex?
    pub var end_src: str
    pub var end: Regex?
    pub var end_has_backref: bool
    pub var is_while: bool
    pub var while_rgx: Regex?
    pub var captures: list[Capture]
    pub var begin_captures: list[Capture]
    pub var end_captures: list[Capture]
    pub var patterns: list[PatternRef]
    pub var apply_end_last: bool

    func init(self):
        self.kind = R_GROUP
        self.scope = ""
        self.content_scope = ""
        self.matcher = none
        self.begin = none
        self.end_src = ""
        self.end = none
        self.end_has_backref = false
        self.is_while = false
        self.while_rgx = none
        self.captures = []
        self.begin_captures = []
        self.end_captures = []
        self.patterns = []
        self.apply_end_last = false

    pub func is_match(self) -> bool:
        return self.kind == R_MATCH

    pub func is_begin(self) -> bool:
        return self.kind == R_BEGIN

    pub func is_group(self) -> bool:
        return self.kind == R_GROUP

## A reference inside a `patterns` list: an inline rule, or an `include` target
## ("$self", "$base", "#name", or another grammar's scope — the last resolved later).
pub class PatternRef:
    pub var rule: Rule?
    pub var include: str

    func init(self):
        self.rule = none
        self.include = ""

## A whole grammar: its scope name, its top-level patterns, and its named repository rules.
pub class Grammar:
    pub var scope_name: str
    pub var patterns: list[PatternRef]
    pub var repository: map[str, Rule]

    func init(self):
        self.scope_name = ""
        self.patterns = []
        self.repository = {}

# mark: Loading ===============================================================================

## Load a grammar from its JSON text.
pub func load(source: str) -> Grammar!:
    let root = try parse(source)
    let grammar = Grammar()
    grammar.scope_name = root.text_of("scopeName")
    grammar.patterns = build_patterns(root.get("patterns"))
    if let repo = root.get("repository"):
        for name in repo.keys():
            if let entry = repo.get(name):
                grammar.repository[name] = build_rule(entry)
    return grammar

func build_patterns(node: Json?) -> list[PatternRef]:
    var out: list[PatternRef] = []
    let arr = node else return out
    if not arr.is_array():
        return out
    var i = 0
    while i < arr.length():
        if let item = arr.at(i):
            let ref = PatternRef()
            if let inc = item.get("include"):
                ref.include = inc.as_str()
            else:
                ref.rule = build_rule(item)
            out.append(ref)
        i += 1
    return out

func build_rule(node: Json) -> Rule:
    let rule = Rule()
    rule.scope = node.text_of("name")
    rule.content_scope = node.text_of("contentName")
    if let m = node.get("match"):
        rule.kind = R_MATCH
        rule.matcher = compile_safe(m.as_str())
        rule.captures = build_captures(node.get("captures"))
        return rule
    if let b = node.get("begin"):
        rule.kind = R_BEGIN
        rule.begin = compile_safe(b.as_str())
        rule.begin_captures = build_captures(first(node, "beginCaptures", "captures"))
        if let e = node.get("end"):
            rule.end_src = e.as_str()
            rule.end_has_backref = has_backref(rule.end_src)
            if not rule.end_has_backref:
                rule.end = compile_safe(rule.end_src)
            rule.end_captures = build_captures(first(node, "endCaptures", "captures"))
        elif let w = node.get("while"):
            rule.is_while = true
            rule.while_rgx = compile_safe(w.as_str())
            rule.end_captures = build_captures(first(node, "whileCaptures", "captures"))
        rule.apply_end_last = bool_of(node.get("applyEndPatternLast"))
        rule.patterns = build_patterns(node.get("patterns"))
        return rule
    rule.kind = R_GROUP
    rule.patterns = build_patterns(node.get("patterns"))
    return rule

## Capture specs are an object keyed by group number; probe a generous range of indices so the
## order of members in the JSON does not matter.
func build_captures(node: Json?) -> list[Capture]:
    var out: list[Capture] = []
    let obj = node else return out
    if not obj.is_object():
        return out
    var i = 0
    while i < 64:
        if let cap = obj.get(str(i)):
            let scope = cap.text_of("name")
            if scope != "":
                out.append(Capture(i, scope))
        i += 1
    return out

func first(node: Json, a: str, b: str) -> Json?:
    if let x = node.get(a):
        return x
    return node.get(b)

func bool_of(node: Json?) -> bool:
    let value = node else return false
    return value.as_bool()

# mark: Direct construction (for embedding grammars in code) ==================================

## Build a single-regex rule.
pub func match_rule(pattern: str, scope: str) -> Rule:
    let rule = Rule()
    rule.kind = R_MATCH
    rule.matcher = compile_safe(pattern)
    rule.scope = scope
    return rule

## Build a begin/end region rule.
pub func begin_end_rule(begin: str, end: str, scope: str) -> Rule:
    let rule = Rule()
    rule.kind = R_BEGIN
    rule.begin = compile_safe(begin)
    rule.end_src = end
    rule.end_has_backref = has_backref(end)
    if not rule.end_has_backref:
        rule.end = compile_safe(end)
    rule.scope = scope
    return rule

## Wrap a rule as a pattern reference, for appending to a grammar's or rule's `patterns`.
pub func ref_of(rule: Rule) -> PatternRef:
    let ref = PatternRef()
    ref.rule = rule
    return ref

## An include pattern reference (e.g. "$self" or "#name").
pub func include_of(target: str) -> PatternRef:
    let ref = PatternRef()
    ref.include = target
    return ref

# mark: Helpers ===============================================================================

## Compile a pattern, or none when it is empty or the engine cannot parse it. A rule with no
## regex simply never matches, so one exotic pattern does not sink a whole grammar.
pub func compile_safe(pattern: str) -> Regex?:
    if pattern == "":
        return none
    let compiled: Regex? = Regex(pattern) catch failure:
        recover none
    return compiled

## Whether an `end` pattern refers back to a `begin` capture (`\1`..`\9` or `\k<name>`), which
## means it must be recompiled per region with those captures substituted in.
pub func has_backref(src: str) -> bool:
    var i = 0
    let n = src.length
    while i < n:
        if src[i..<i + 1] == "\\" and i + 1 < n:
            let c = src[i + 1..<i + 2]
            if (c >= "1" and c <= "9") or c == "k":
                return true
            i += 2
        else:
            i += 1
    return false

test "grammar loads patterns and repository":
    let g = load("{\"scopeName\":\"source.x\",\"patterns\":[{\"match\":\"a\",\"name\":\"k\"},{\"include\":\"#num\"}],\"repository\":{\"num\":{\"match\":\"[0-9]+\",\"name\":\"n\"}}}")
    assert(g.scope_name == "source.x")
    assert(g.patterns.length == 2)
    let p0 = g.patterns[0].rule else return
    assert(p0.is_match() and p0.scope == "k")
    assert(g.patterns[1].include == "#num")
    let num = g.repository["num"] else return
    assert(num.scope == "n")

test "grammar loads begin/end regions":
    let g = load("{\"scopeName\":\"source.y\",\"patterns\":[{\"begin\":\"/\\\\*\",\"end\":\"\\\\*/\",\"name\":\"comment.block\",\"contentName\":\"c\"}]}")
    let r = g.patterns[0].rule else return
    assert(r.is_begin() and r.scope == "comment.block" and r.content_scope == "c")
    assert(not r.end_has_backref)
