#==============================================================================================
#
#   json - a small JSON reader that yields held values
#
#   DESCRIPTION:
#       Parses JSON text into a tree of `Json` values a Luce program can keep and walk freely:
#       objects, arrays, strings, numbers, booleans and null. It exists because grammar loading
#       needs to hold the parsed document, whereas the standard decoder returns borrowed cursors
#       over a native buffer. Numbers are kept as their source text and read on demand. Depends
#       only on the prelude.
#
#==============================================================================================

## Malformed JSON.
pub let parse_error: ErrorCode = ErrorCode.package(331)

let J_NULL = 0
let J_BOOL = 1
let J_NUMBER = 2
let J_STRING = 3
let J_ARRAY = 4
let J_OBJECT = 5

let MAX_DEPTH = 400

# mark: The value =============================================================================

## One JSON value. Arrays keep their elements in `items`; objects keep members in `obj`; a
## number keeps its source text so it can be read as an int without a float conversion.
pub class Json:
    var tag: int
    var flag: bool
    var text: str
    var items: list[Json]
    var obj: map[str, Json]
    var key_order: list[str]

    func init(self, tag: int):
        self.tag = tag
        self.flag = false
        self.text = ""
        self.items = []
        self.obj = {}
        self.key_order = []

    pub func kind(self) -> int:
        return self.tag

    pub func is_null(self) -> bool:
        return self.tag == J_NULL

    pub func is_string(self) -> bool:
        return self.tag == J_STRING

    pub func is_number(self) -> bool:
        return self.tag == J_NUMBER

    pub func is_array(self) -> bool:
        return self.tag == J_ARRAY

    pub func is_object(self) -> bool:
        return self.tag == J_OBJECT

    ## The text of a string (or a number's source); "" for other kinds.
    pub func as_str(self) -> str:
        return self.text

    pub func as_bool(self) -> bool:
        return self.flag

    ## A number (or numeric string) as an integer; 0 when it is not one.
    pub func as_int(self) -> int:
        var value = 0
        var negative = false
        var i = 0
        if self.text.length > 0 and self.text[0..<1] == "-":
            negative = true
            i = 1
        while i < self.text.length:
            let d = self.text[i..<i + 1]
            if d >= "0" and d <= "9":
                value = value * 10 + digit_of(d)
            i += 1
        return -value if negative else value

    ## The number of elements in an array (or members in an object).
    pub func length(self) -> int:
        if self.tag == J_OBJECT:
            return self.obj.length
        return self.items.length

    ## The array element at `index`, or none.
    pub func at(self, index: int) -> Json?:
        if index >= 0 and index < self.items.length:
            return self.items[index]
        return none

    ## The object member named `name`, or none.
    pub func get(self, name: str) -> Json?:
        return self.obj[name]

    ## The object's member names, in the order they were parsed.
    pub func keys(self) -> list[str]:
        return self.key_order

    ## The text of the object member `name`, or `fallback` when it is absent or not a string.
    pub func text_of(self, name: str, fallback: str = "") -> str:
        let member = self.obj[name] else return fallback
        if member.tag == J_STRING:
            return member.text
        return fallback

# mark: The reader ============================================================================

class Reader:
    var s: list[str]
    var n: int
    var i: int
    var depth: int

    func init(self, text: str):
        self.s = []
        for ch in text:
            self.s.append(ch)
        self.n = self.s.length
        self.i = 0
        self.depth = 0

    func peek(self) -> str:
        return self.s[self.i] if self.i < self.n else ""

    func skip_ws(self) -> unit:
        while self.i < self.n and (self.s[self.i] == " " or self.s[self.i] == "\t" or self.s[self.i] == "\n" or self.s[self.i] == "\r"):
            self.i += 1

    func value(self) -> Json!:
        self.skip_ws()
        self.depth += 1
        if self.depth > MAX_DEPTH:
            error(parse_error, "JSON nested too deeply")
        let node = try self.dispatch()
        self.depth -= 1
        return node

    func dispatch(self) -> Json!:
        let c = self.peek()
        if c == "{":
            return try self.object()
        if c == "[":
            return try self.array()
        if c == "\"":
            let node = Json(J_STRING)
            node.text = try self.read_string()
            return node
        if c == "t" or c == "f":
            return try self.boolean()
        if c == "n":
            return try self.literal_null()
        if c == "-" or (c >= "0" and c <= "9"):
            return self.number()
        error(parse_error, "unexpected character in JSON")

    func object(self) -> Json!:
        self.i += 1
        let node = Json(J_OBJECT)
        self.skip_ws()
        if self.peek() == "}":
            self.i += 1
            return node
        while true:
            self.skip_ws()
            if self.peek() != "\"":
                error(parse_error, "expected a string key")
            let key = try self.read_string()
            self.skip_ws()
            if self.peek() != ":":
                error(parse_error, "expected ':' after a key")
            self.i += 1
            node.obj[key] = try self.value()
            node.key_order.append(key)
            self.skip_ws()
            let d = self.peek()
            if d == ",":
                self.i += 1
            elif d == "}":
                self.i += 1
                return node
            else:
                error(parse_error, "expected ',' or '}' in object")
        error(parse_error, "unterminated object")

    func array(self) -> Json!:
        self.i += 1
        let node = Json(J_ARRAY)
        self.skip_ws()
        if self.peek() == "]":
            self.i += 1
            return node
        while true:
            node.items.append(try self.value())
            self.skip_ws()
            let d = self.peek()
            if d == ",":
                self.i += 1
            elif d == "]":
                self.i += 1
                return node
            else:
                error(parse_error, "expected ',' or ']' in array")
        error(parse_error, "unterminated array")

    func read_string(self) -> str!:
        self.i += 1
        var out = ""
        while self.i < self.n:
            let c = self.s[self.i]
            if c == "\"":
                self.i += 1
                return out
            if c == "\\":
                self.i += 1
                out += try self.unescape()
            else:
                out += c
                self.i += 1
        error(parse_error, "unterminated string")

    func unescape(self) -> str!:
        if self.i >= self.n:
            error(parse_error, "escape at end of input")
        let c = self.s[self.i]
        self.i += 1
        if c == "\"":
            return "\""
        if c == "\\":
            return "\\"
        if c == "/":
            return "/"
        if c == "n":
            return "\n"
        if c == "t":
            return "\t"
        if c == "r":
            return "\r"
        if c == "b":
            return cp_to_str(8)
        if c == "f":
            return cp_to_str(12)
        if c == "u":
            var hex = ""
            var k = 0
            while k < 4 and self.i < self.n:
                hex += self.s[self.i]
                self.i += 1
                k += 1
            return cp_to_str(hex_value(hex))
        return c

    func boolean(self) -> Json!:
        if self.starts("true"):
            self.i += 4
            let node = Json(J_BOOL)
            node.flag = true
            return node
        if self.starts("false"):
            self.i += 5
            let node = Json(J_BOOL)
            node.flag = false
            return node
        error(parse_error, "invalid literal")

    func literal_null(self) -> Json!:
        if self.starts("null"):
            self.i += 4
            return Json(J_NULL)
        error(parse_error, "invalid literal")

    func number(self) -> Json:
        var raw = ""
        if self.peek() == "-":
            raw += "-"
            self.i += 1
        while self.i < self.n and is_number_char(self.s[self.i]):
            raw += self.s[self.i]
            self.i += 1
        let node = Json(J_NUMBER)
        node.text = raw
        return node

    func starts(self, word: str) -> bool:
        var k = 0
        for ch in word:
            if self.i + k >= self.n or self.s[self.i + k] != ch:
                return false
            k += 1
        return true

# mark: Entry and helpers =====================================================================

## Parse `text` into a value tree, or fail with `parse_error`.
pub func parse(text: str) -> Json!:
    let reader = Reader(text)
    let node = try reader.value()
    reader.skip_ws()
    if reader.i < reader.n:
        error(parse_error, "trailing content after JSON value")
    return node

func is_number_char(ch: str) -> bool:
    return (ch >= "0" and ch <= "9") or ch == "." or ch == "e" or ch == "E" or ch == "+" or ch == "-"

func digit_of(d: str) -> int:
    var i = 0
    while i < 10:
        if "0123456789"[i..<i + 1] == d:
            return i
        i += 1
    return 0

func hex_value(digits: str) -> int:
    var value = 0
    for d in digits:
        value = value * 16 + hex_digit(d)
    return value

func hex_digit(d: str) -> int:
    if d >= "0" and d <= "9":
        return digit_of(d)
    if d >= "a" and d <= "f":
        return 10 + index_in("abcdef", d)
    if d >= "A" and d <= "F":
        return 10 + index_in("ABCDEF", d)
    return 0

func index_in(s: str, ch: str) -> int:
    var i = 0
    while i < s.length:
        if s[i..<i + 1] == ch:
            return i
        i += 1
    return 0

let ASCII_CTRL = "\u{0}\u{1}\u{2}\u{3}\u{4}\u{5}\u{6}\u{7}\u{8}\u{9}\u{a}\u{b}\u{c}\u{d}\u{e}\u{f}\u{10}\u{11}\u{12}\u{13}\u{14}\u{15}\u{16}\u{17}\u{18}\u{19}\u{1a}\u{1b}\u{1c}\u{1d}\u{1e}\u{1f}"
let ASCII_PRINT = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"

## The one-scalar string for a codepoint. The ASCII range comes from tables; a codepoint of 128
## or more returns "" (grammar JSON is ASCII in practice) until a runtime scalar builder lands.
func cp_to_str(cp: int) -> str:
    if cp < 0:
        return ""
    if cp < 32:
        return ASCII_CTRL[cp..<cp + 1]
    if cp < 127:
        return ASCII_PRINT[cp - 32..<cp - 31]
    if cp == 127:
        return "\u{7f}"
    return ""

# mark: Tests =================================================================================

test "json objects, arrays and access":
    let v = parse("{\"name\":\"source.x\",\"patterns\":[{\"match\":\"\\\\b\"},{\"n\":1}],\"flag\":true}")
    assert(v.is_object())
    let name = v.get("name") else return
    assert(name.as_str() == "source.x")
    let pats = v.get("patterns") else return
    assert(pats.is_array() and pats.length() == 2)
    let p0 = pats.at(0) else return
    let m = p0.get("match") else return
    assert(m.as_str() == "\\b")
    let p1 = pats.at(1) else return
    let n = p1.get("n") else return
    assert(n.is_number() and n.as_int() == 1)
    let flag = v.get("flag") else return
    assert(flag.as_bool())
    assert(v.text_of("name") == "source.x")
    assert(v.text_of("missing", "d") == "d")

test "json string escapes and literals":
    let v = parse("\"tab\\there\\nline\"")
    assert(v.as_str() == "tab\there\nline")
    let nums = parse("[0, -12, 3.5, true, false, null]")
    assert(nums.length() == 6)
    let a = nums.at(1) else return
    assert(a.as_int() == -12)
    let b = nums.at(4) else return
    assert(b.kind() == J_BOOL and not b.as_bool())
    let c = nums.at(5) else return
    assert(c.is_null())
