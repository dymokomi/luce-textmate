#prisma 4.0
def package "luce-textmate" {
    str owner = "dymokomi"
    str version = "0.2.5"
    str kind = "package"
    str language = "luce-base"
    str description = "Loads TextMate grammars (.tmLanguage.json) and tokenizes source a line at a time into scoped spans, so an editor can color any language by dropping in its grammar file. It matches with luce-regex and depends only on that plus the standard library."
    str readme = "README.md"

    def export "tm" {
        str module = "luce_textmate.textmate"
    }

    def dependency "luce-regex" {
        str owner = "dymokomi"
        str version = "^0.2.2"
        str path = "../luce-regex"
    }

    def dependency "luce-json" {
        str owner = "dymokomi"
        str version = "^0.2.0"
        str path = "../luce-json"
    }

    def dependency "luce-std" {
        str owner = "dymokomi"
        str version = "^0.1.0"
        str path = "../luce-std"
    }
}
